// ============================================================================
// SamaanShare - Database Schema
// ============================================================================
// Peer-to-Peer Rental Marketplace for Pakistan (PKR, Asia/Karachi)
//
// Source of truth: docs/DATABASE.md section 2 (Architecture Locked v1.0),
// as amended by the Phase 0.3B design review.
//
// Conventions (docs/ENGINEERING_GUIDELINES.md section 2):
//   - Models are PascalCase singular; tables are lowercase plural via @@map
//   - Enum values are SCREAMING_SNAKE_CASE
//   - All PKR amounts are Int - PKR has no fractional unit
//   - Cities are stored as lowercase slugs ("karachi"); render labels with
//     getCityLabel() from src/config/cities.ts
//   - Users and listings are soft-deleted via deletedAt; nothing financial
//     cascades. Queries must filter deletedAt: null
//
// Deferred to Phase 2: Conversation and Message (real-time messaging).
// Their definitions remain in docs/DATABASE.md section 2.
// ============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

// D8: REJECTED added - admins can approve/reject listings (ARCHITECTURE.md:488).
// DELETED remains the queryable state; deletedAt records when it happened.
enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  REJECTED
  DELETED
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

// Lifecycle per PRD 4.4 / ARCHITECTURE.md section 6:
// PENDING -> APPROVED -> PAYMENT_PENDING -> ACTIVE -> COMPLETED -> REVIEWED
enum BookingStatus {
  PENDING // Awaiting owner approval
  APPROVED // Owner accepted, awaiting payment
  PAYMENT_PENDING // Waiting for offline payment confirmation
  ACTIVE // Currently rented (item picked up)
  COMPLETED // Successfully returned
  REVIEWED // Both parties have left reviews
  DECLINED // Owner declined the request
  CANCELLED // Cancelled by either party
  EXPIRED // Request expired without response
}

enum PaymentProvider {
  OFFLINE // Cash, Bank Transfer (MVP)
  JAZZCASH // Future
  EASYPAISA // Future
  SAFEPAY // Future
  PAYFAST // Future
  STRIPE // Future (International)
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  JAZZCASH_WALLET
  EASYPAISA_WALLET
  CREDIT_CARD
  DEBIT_CARD
}

enum PaymentStatus {
  PENDING
  AWAITING_CONFIRMATION // Waiting for owner to confirm receipt
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum ReviewType {
  OWNER_TO_RENTER
  RENTER_TO_OWNER
}

// Trust & Safety: the two moments an item changes hands.
enum HandoverType {
  PICKUP
  RETURN
}

// The condition an item was in at a handover, as the owner recorded it.
// Deliberately NOT ItemCondition, which grades an item in the abstract for a
// listing. This grades it against what was expected at this moment, which is the
// only question a later damage claim actually asks.
enum HandoverCondition {
  AS_EXPECTED
  MINOR_WEAR
  DAMAGED
}

// Whether the other party backed the record up.
// PENDING is not a failure state and never blocks the rental - see
// src/lib/handover/rules.ts. It means nobody has answered yet, which is
// different from disagreeing, and a claim built on a record needs to know which.
enum HandoverConfirmation {
  PENDING
  AGREED
  DISPUTED
}

// Trust & Safety: a claim against a rental's security deposit.
//
// WHY NOT A ReportReason. `ITEM_DAMAGED` and `ITEM_NOT_RETURNED` already exist
// there, and both are filed against a *person* - Report.targetId is polymorphic
// with no foreign key, so it can reach neither the booking, nor the deposit, nor
// the return handover record, which are the three things a claim is about.
enum ClaimReason {
  DAMAGED
  MISSING_PARTS
  NOT_RETURNED
  LATE_RETURN
  CLEANING_REQUIRED
  OTHER
}

/**
 * Where a claim stands.
 * ACCEPTED settles without an administrator: the two parties agree, and there is
 * nothing left for a third to decide. Only DISPUTED reaches the queue.
 * Silence is NOT acceptance. An unanswered claim escalates to DISPUTED once its
 * window closes, so a renter who misses a notification never loses money by
 * default - unlike a handover record, a claim has a price attached.
 */
enum ClaimStatus {
  OPEN
  ACCEPTED
  DISPUTED
  RESOLVED
  WITHDRAWN
}

/**
 * What an administrator did to an account. Phase 6.
 * WHY A LOG AND NOT COLUMNS ON User. `verifiedAt`/`verifiedById` record the
 * CURRENT state of one flag, which is all the trust score needs. Suspension is
 * different: "was this account ever suspended" stays a real question after it has
 * been reinstated, and a column pair would have the second suspension overwrite
 * the first. One row per action keeps the history, and one shape covers
 * suspension, ban, reinstatement and role changes rather than three columns each.
 */
enum AdminActionType {
  SUSPEND_USER
  BAN_USER
  REINSTATE_USER
  CHANGE_ROLE
  VERIFY_IDENTITY
  WITHDRAW_VERIFICATION
  // Listing moderation. The subject of these is still the OWNER, not the listing:
  // "this account had a listing taken down" is what a moderator needs to see when
  // deciding about the person, and `AdminAction.listingId` records which one.
  REMOVE_LISTING
  RESTORE_LISTING
  EDIT_LISTING
}

enum ReportType {
  USER
  LISTING
  REVIEW
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

// D5: replaces the former free-text `reason String`. Satisfies PRD.md:241
// "predefined reason categories". Approved value set, MVP scope.
// PAYMENT_DISPUTE intentionally excluded: payments are offline in Phase 1, so
// the platform has no payment record to dispute. Revisit when JazzCash /
// Easypaisa land in Phase 2.
enum ReportReason {
  SPAM
  SCAM_OR_FRAUD
  INAPPROPRIATE_CONTENT
  MISLEADING_DESCRIPTION
  INCORRECT_PRICING
  PROHIBITED_ITEM
  COUNTERFEIT_ITEM
  UNSAFE_ITEM
  ITEM_DAMAGED
  ITEM_NOT_RETURNED
  HARASSMENT
  NO_SHOW
  FAKE_REVIEW
  OFFENSIVE_LANGUAGE
  OTHER
}

// P4: resolveReport() in API.md:425 accepts an `action` that was being discarded.
enum ReportAction {
  NONE
  SUSPEND_USER
  REMOVE_LISTING
  REMOVE_REVIEW
}

// P1: In-app booking notifications are ROADMAP.md:155 "Must" for Phase 1 and
// PRD.md:199/201 Must Have. Values derived from the booking lifecycle plus
// PRD 4.7 (reviews) and 4.10 (reports).
enum NotificationType {
  BOOKING_REQUESTED
  BOOKING_APPROVED
  BOOKING_DECLINED
  BOOKING_CANCELLED
  BOOKING_EXPIRED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  BOOKING_ACTIVE
  BOOKING_COMPLETED
  DEPOSIT_RETURNED
  REVIEW_RECEIVED
  REVIEW_REMINDER
  REPORT_RESOLVED
  // Trust & Safety: the counterparty disagreed with a handover condition record.
  // Only the disagreement notifies. Agreement is the expected path, and a
  // notification for the expected path is noise - which makes the unread badge
  // less trustworthy, the one thing a badge has to be.
  HANDOVER_DISPUTED
  // Trust & Safety: deposit claims. All three notify, unlike a handover, because
  // every one of them changes what the other party is owed or owes - there is no
  // "expected path" here that a person could safely not hear about.
  CLAIM_FILED
  CLAIM_RESPONDED
  CLAIM_RESOLVED
  // Stage A: pickup instructions are the only channel between the two parties
  // until profiles carry a verified phone, so an owner correcting a wrong
  // address has to be able to reach a renter who already read the old one.
  // Appended rather than inserted: nothing orders by this enum (unlike
  // BookingStatus, where declaration order drives the requests screen).
  BOOKING_INSTRUCTIONS_UPDATED
}

// ==================== AUTH.JS MODELS ====================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // For credentials provider (hashed, bcrypt)

  // Extended profile fields
  phone         String?
  phoneVerified Boolean @default(false)
  bio           String? @db.Text
  city          String? // D1: lowercase slug - "karachi", not "Karachi"
  avatarUrl     String?

  // Platform fields
  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  /**
   * Generation counter for this account's sessions. Incremented to invalidate
   * every session issued before now.
   * WHY A COUNTER AND NOT A TIMESTAMP. Sessions are JWTs (see the note on
   * `session.strategy` in src/auth.config.ts), so there is no row to delete: a
   * stolen cookie stays valid until it expires, up to 30 days. The token carries
   * the value this column had when it was minted, and the session helpers - which
   * already read this row to check `status` - refuse any token whose copy has
   * fallen behind. A password change therefore takes effect on the attacker's very
   * next request rather than at token expiry.
   * A counter rather than `passwordChangedAt` compared against the token's `iat`
   * because `iat` moves on its own: `updateAge` re-issues a token every 24h, so a
   * timestamp comparison would keep resurrecting a session that had been revoked.
   * An explicit generation is only ever changed by us.
   * Incremented by `changePassword` and by `resetPassword`. NOT by `setPassword` -
   * an account that never had one has no password-authenticated session to revoke.
   * Both of those flows re-authenticate the member afterwards, which is what stops
   * the person who just changed their password being signed out along with everyone
   * else.
   */
  tokenVersion Int @default(0)

  // ==================== PREFERENCES (Phase 2.2) ====================

  /**
   * Where this member is shown listings when they have not asked for anywhere
   * in particular. A lowercase slug, like `city` (decision D1), or null for no
   * preference.
   * NOT A HIDDEN FILTER. `/listings` documents that its whole state lives in the
   * query string and nowhere else, so that any view is shareable and reachable
   * with the back button. Applying this behind the URL would break exactly that -
   * two people would see different results at the same address. So it is applied
   * by REDIRECTING a bare `/listings` to `?city=<slug>`: the preference chooses
   * the starting URL, and from there the URL is still the only state. `?city=all`
   * is how "everywhere" is said out loud, which is what the city chip's remove
   * link points at - without it, clearing the city would land back on the bare
   * URL and bounce straight back here.
   */
  defaultCity String?

  /**
   * WHICH NOTIFICATIONS MAY BE TURNED OFF, AND WHY SO FEW.
   * Notifications are written inside the same transaction as the booking change
   * they describe - see src/lib/notifications/create.ts - precisely so a member
   * cannot fail to learn that a booking moved, a payment was confirmed, or a
   * claim was filed against their deposit. Letting those be switched off would
   * turn a deliberate guarantee into a setting, and the failure mode is someone
   * silently not hearing that they owe money.
   * What is left is the genuinely advisory: a nudge to write a review, and the
   * notice that a review went public. Neither carries an obligation and neither
   * is the only record of anything. Those are real preferences, so they are real
   * switches; everything else is not offered rather than offered and ignored.
   */
  notifyReviewReminders Boolean @default(true)
  notifyReviewPublished Boolean @default(true)

  /**
   * Identity verified by SamaanShare. Trust & Safety.
   * NOT the same claim as `emailVerified`, and the gap is the whole point.
   * Confirming an inbox takes a minute and proves control of an email address;
   * this is meant to mean a human checked a document against a person. The trust
   * score weights them 1.0 against 0.4 for exactly that reason, and withholds its
   * top band entirely without this one.
   * Granted by an administrator until phone OTP and CNIC checks exist (Phase 2),
   * which is why it carries who decided and when - a claim this strong, made by
   * the platform about a person, has to be attributable to someone.
   */
  isVerified   Boolean   @default(false)
  verifiedAt   DateTime?
  verifiedById String?

  // P8: denormalized review aggregate. PRD.md:169 makes "Sort by Rating" a
  // Must Have and API.md:613 exposes sortBy:'rating'. Ordering paginated
  // listings by their owner's rating is not expressible in SQL without a
  // stored aggregate. Recalculated in the transaction that PUBLISHES a Review,
  // never when one is written - see Review.publishedAt for why that distinction
  // is the whole of reciprocal release.
  // Float rather than Decimal: this is not currency, and an average of
  // integers 1-5 needs no exact decimal representation.
  //
  // WHY TWO PAIRS AND NOT ONE. A person is reviewed in both directions - as an
  // owner letting an item out, and as a renter borrowing one - and the two
  // measure different things. A single mixed average meant a listing page could
  // show 4.8 above a list of owner reviews averaging 3.2 the moment that person
  // had also rented: the number and the evidence directly beneath it
  // contradicted each other, which is worse than showing neither. Split here so
  // each surface can state the figure it actually has reviews for.
  // ownerRating* aggregates RENTER_TO_OWNER reviews received (this person as an
  // owner); renterRating* aggregates OWNER_TO_RENTER. Fed by the
  // [revieweeId, type] index, which existed for this from the start.
  ownerRatingAverage  Float? // 1.00 - 5.00, as an owner
  ownerRatingCount    Int    @default(0)
  renterRatingAverage Float? // 1.00 - 5.00, as a renter
  renterRatingCount   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // D3: soft deletion. Users are never physically deleted - anonymise the
  // profile and stamp this instead, so bookings, reviews and payment history
  // survive. Every user-facing query must filter `deletedAt: null`.
  deletedAt DateTime?

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // App relations
  listings          Listing[]      @relation("OwnerListings")
  bookingsAsRenter  Booking[]      @relation("RenterBookings")
  bookingsAsOwner   Booking[]      @relation("OwnerBookings")
  reviewsGiven      Review[]       @relation("ReviewsGiven")
  reviewsReceived   Review[]       @relation("ReviewsReceived")
  savedListings     SavedListing[]
  reportsSubmitted  Report[]       @relation("ReportsSubmitted")
  reportsResolved   Report[]       @relation("ReportsResolved")
  paymentsConfirmed Payment[]      @relation("PaymentsConfirmed") // P7
  notifications     Notification[] // P1

  // Phase 4: who cancelled a booking. A real foreign key rather than a bare
  // userId, for the same reason as Payment.confirmedById (P7).
  bookingsCancelled Booking[] @relation("BookingsCancelled")

  // Stage A2: outstanding password reset requests.
  passwordResetTokens PasswordResetToken[]

  // Trust & Safety: outstanding email confirmation links.
  emailVerificationTokens EmailVerificationToken[]

  // Trust & Safety: handover records this person wrote, and ones they answered.
  handoversRecorded  HandoverRecord[] @relation("HandoversRecorded")
  handoversConfirmed HandoverRecord[] @relation("HandoversConfirmed")

  // Phase 6: admin actions this person took, and ones taken against them.
  adminActionsTaken    AdminAction[] @relation("AdminActionsTaken")
  adminActionsReceived AdminAction[] @relation("AdminActionsReceived")

  // Trust & Safety: deposit claims filed, received, resolved, and photographed.
  claimsFiled    DamageClaim[] @relation("ClaimsFiled")
  claimsAgainst  DamageClaim[] @relation("ClaimsAgainst")
  claimsResolved DamageClaim[] @relation("ClaimsResolved")
  claimPhotos    ClaimPhoto[]  @relation("ClaimPhotos")

  // Who granted this account's identity verification, and whose grants they are.
  // A real foreign key rather than a bare id, for the same reason as
  // Payment.confirmedById and Report.resolvedBy: the row should say who vouched.
  verifiedBy    User?  @relation("IdentityVerifications", fields: [verifiedById], references: [id])
  verifiedUsers User[] @relation("IdentityVerifications")

  @@index([status]) // P5: admin user filtering - API.md:432
  @@index([city]) // P5: usersByCity stat - API.md:390
  @@index([deletedAt]) // D3: exclude soft-deleted users
  @@index([verifiedById]) // Trust & Safety: an admin's own grants
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId]) // P5: PostgreSQL does not auto-index foreign keys
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId]) // P5
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/**
 * Password reset tokens. Stage A2.
 * WHY NOT REUSE VerificationToken. That table belongs to the Auth.js adapter and
 * has no type discriminator and no used-marker - so a password-reset token and
 * an email-verification token would be indistinguishable, and one could be
 * redeemed as the other. It also cannot record single use, which is the property
 * that stops a leaked reset link being replayed after the fact.
 * ONLY A HASH IS STORED. The token in the emailed URL is never written down. A
 * leaked database dump of plaintext reset tokens is account takeover for every
 * user with an outstanding request; a dump of SHA-256 hashes of 256-bit random
 * values is worth nothing. SHA-256 rather than bcrypt is deliberate and correct
 * here: bcrypt's slowness exists to protect low-entropy secrets that humans
 * chose, and these are high-entropy values a CSPRNG chose - there is nothing to
 * brute-force, and a fast hash keeps the unique-index lookup a single probe
 * instead of a table scan.
 */
model PasswordResetToken {
  id     String @id @default(cuid())
  userId String

  /**
   * SHA-256 of the token from the emailed link. Unique, so lookup is one probe.
   */
  tokenHash String @unique

  expiresAt DateTime

  /**
   * Set when redeemed. Non-null means the token is spent and cannot be replayed.
   */
  usedAt DateTime?

  createdAt DateTime @default(now())

  // Cascade is right here, unlike the financial relations: a reset token has no
  // value as history and must not outlive the account it belongs to. Users are
  // soft-deleted in practice, so this rarely fires.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // Sweeping expired tokens.
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/**
 * Outstanding email confirmation links. Trust & Safety.
 * WHY NOT REUSE PasswordResetToken OR Auth.js's VerificationToken. The same
 * argument Stage A2 made for splitting reset tokens out applies again, in both
 * directions: a single table with no type discriminator lets a token minted for
 * one purpose be redeemed for another, and an email-confirmation link is a far
 * weaker credential than a password reset - handing one the other's powers is a
 * privilege escalation, not a tidy-up.
 * Same mechanics as the reset token, and for the same reasons: the token is 256
 * bits of CSPRNG output, stored only as a SHA-256 digest, single-use by
 * compare-and-swap on usedAt.
 */
model EmailVerificationToken {
  id     String @id @default(cuid())
  userId String

  /**
   * SHA-256 of the token from the emailed link. Unique, so lookup is one probe.
   */
  tokenHash String @unique

  /**
   * The address this link was sent to, and the address it may confirm.
   * Bound at mint time rather than read from the user at redemption. Without it,
   * a link emailed to an old address would confirm whatever address the account
   * happens to carry when it is finally clicked - so changing an email to one you
   * do not control, then clicking an older link, would mark it verified.
   */
  email String

  expiresAt DateTime

  /**
   * Set when redeemed. Non-null means the token is spent and cannot be replayed.
   */
  usedAt DateTime?

  createdAt DateTime @default(now())

  // Cascade, like the reset token: a confirmation link has no value as history.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

// ==================== CATEGORY MODELS ====================

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  icon        String? // Lucide icon name
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subcategories Subcategory[]
  listings      Listing[]

  @@map("categories")
}

model Subcategory {
  id         String @id @default(cuid())
  categoryId String
  name       String
  slug       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  listings Listing[]

  @@unique([categoryId, slug])
  @@index([categoryId]) // P5
  @@map("subcategories")
}

// ==================== LISTING MODELS ====================

model Listing {
  id      String @id @default(cuid())
  ownerId String

  // Basic info
  title       String
  description String @db.Text

  // Categorization
  categoryId    String
  subcategoryId String?
  condition     ItemCondition

  // D2: PKR amounts are Int. PKR has no fractional unit, so Int matches the
  // Zod schemas (z.number().int()) and formatPKR(amount: number) exactly, with
  // no Decimal conversion at any boundary. Postgres Int caps at 2,147,483,647
  // PKR - far above the 10,000,000 ceiling in API.md:762.
  pricePerDay     Int
  pricePerWeek    Int?
  pricePerMonth   Int?
  securityDeposit Int

  // Location
  city      String // D1: lowercase slug - "karachi", not "Karachi"
  area      String? // DHA, Gulshan, Johar, etc.
  latitude  Float?
  longitude Float?

  // Status & metrics
  status    ListingStatus @default(DRAFT)
  viewCount Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // D3: soft deletion, mirroring User. `status = DELETED` is what queries
  // filter on; this records when it happened.
  deletedAt DateTime?

  // Relations
  owner            User              @relation("OwnerListings", fields: [ownerId], references: [id], onDelete: Restrict)
  category         Category          @relation(fields: [categoryId], references: [id])
  subcategory      Subcategory?      @relation(fields: [subcategoryId], references: [id])
  images           ListingImage[]
  unavailableDates UnavailableDate[]
  bookings         Booking[]
  savedBy          SavedListing[]
  // Moderation history for this listing - removals, restorations and edits.
  adminActions     AdminAction[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([city])
  @@index([status])
  @@index([pricePerDay])
  @@index([subcategoryId]) // P5
  // P6: the browse/search page filters on status + city + category + price
  // simultaneously (PRD 4.3, all Must Have) under a <500ms budget (PRD 7).
  // Single-column indexes cannot serve a multi-column filter.
  @@index([status, city, categoryId])
  @@index([status, city, pricePerDay])
  @@index([status, createdAt]) // "Sort by Newest" - PRD.md:167
  @@map("listings")
}

model ListingImage {
  id        String @id @default(cuid())
  listingId String
  url       String // Cloudinary URL
  // Unique because one Cloudinary asset must belong to at most one listing. The
  // create action already refuses a publicId that is attached elsewhere, but that
  // check and the insert are separate statements: two concurrent submissions of the
  // same photo both pass it, then both write. Deleting either listing would then
  // destroy an image the other still displays. This constraint is what actually
  // makes the rule hold - the application check turns it into a friendly error
  // instead of a raw P2002.
  publicId  String @unique // Cloudinary public ID for deletion
  order     Int    @default(0)

  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_images")
}

// D7: THE single source of truth for blocked dates. A row here means the date
// cannot be booked, whether the owner blocked it or a booking consumed it.
// The @@unique([listingId, date]) constraint is what physically prevents
// double-booking: two concurrent bookings for the same day cannot both insert.
model UnavailableDate {
  id        String   @id @default(cuid())
  listingId String
  date      DateTime @db.Date
  reason    String? // "owner_blocked" | "booked"

  // [NEW-2] Consequence of removing BookingDate. Without this, a row with
  // reason="booked" cannot say WHICH booking holds it, so cancelling a booking
  // would have to re-derive its dates by range arithmetic and delete by date
  // range - which silently destroys owner-blocked dates that overlap.
  // Null for owner-blocked dates; set for booking-held dates.
  // onDelete: Cascade means cancelling or deleting a booking releases exactly
  // its own dates and nothing else.
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([listingId])
  @@index([bookingId]) // P5
  @@index([listingId, date]) // availability calendar range scans
  @@map("unavailable_dates")
}

// ==================== PAYMENT MODELS ====================

model Payment {
  id String @id @default(cuid())

  // Provider-agnostic fields
  provider PaymentProvider @default(OFFLINE)
  method   PaymentMethod
  status   PaymentStatus   @default(PENDING)

  // Amounts (all in PKR) - D2: Int, see note on Listing pricing
  amount          Int
  securityDeposit Int
  currency        String @default("PKR")

  // Provider-specific reference
  transactionRef String? // External transaction ID
  metadata       Json? // Provider-specific data

  // Confirmation (for offline payments)
  confirmedAt DateTime?

  // P7: DATABASE.md declared `confirmedBy String?` as a bare userId with no
  // relation, so nothing stopped an invalid id and admin views could not join
  // to the confirming user. Promoted to a real foreign key.
  confirmedById String?
  confirmedBy   User?   @relation("PaymentsConfirmed", fields: [confirmedById], references: [id])

  // P2: markDepositReturned() is a defined Server Action (API.md:250) and
  // "Deposit Return Tracking" is PRD.md:193, but no field recorded it.
  depositReturnedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  booking Booking?

  @@index([status])
  @@index([provider])
  @@index([confirmedById]) // P5
  @@map("payments")
}

// ==================== BOOKING MODELS ====================

model Booking {
  id        String  @id @default(cuid())
  listingId String
  renterId  String
  ownerId   String
  paymentId String? @unique

  // Dates
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  // Pricing captured at booking time - D2: Int, in PKR
  totalPrice      Int
  securityDeposit Int

  // Status
  status BookingStatus @default(PENDING)

  // Details
  pickupInstructions String? @db.Text
  notes              String? @db.Text // Renter notes to owner

  // P3: declineBooking() and cancelBooking() both accept a `reason`
  // (API.md:196, API.md:205) that previously had nowhere to go. A booking takes
  // only one terminal path, so a single field covers both.
  statusReason String? @db.Text

  /**
   * Lifecycle timestamps, Phase 4.
   * `updatedAt` cannot carry these: every transition overwrites it, so after a
   * completed rental there is no record of when the item was actually handed
   * over. `completedAt` in particular is the clock the deposit-return window and
   * the review window are measured from, and both outlive the transition itself.
   */
  startedAt   DateTime? // Picked up - PAYMENT_PENDING -> ACTIVE
  completedAt DateTime? // Returned - ACTIVE -> COMPLETED
  cancelledAt DateTime?

  /**
   * Who cancelled, when someone did.
   * `statusReason` is free text and cannot answer "was this the renter or the
   * owner", which is the question that decides what the other side is told - and
   * later, whose record it lands on.
   */
  cancelledById String?
  cancelledBy   User?   @relation("BookingsCancelled", fields: [cancelledById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  listing Listing  @relation(fields: [listingId], references: [id])
  renter  User     @relation("RenterBookings", fields: [renterId], references: [id])
  owner   User     @relation("OwnerBookings", fields: [ownerId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])
  reviews Review[]

  // Trust & Safety: the pickup and return condition records, at most one each.
  handovers HandoverRecord[]

  // Trust & Safety: the deposit claim, at most one.
  claim DamageClaim?

  // D7: replaces the removed BookingDate join. These are the UnavailableDate
  // rows this booking holds.
  heldDates UnavailableDate[]

  @@index([listingId])
  @@index([renterId])
  @@index([ownerId])
  @@index([status])
  @@index([listingId, status]) // P6: availability + listing booking history
  @@index([cancelledById])
  // Phase 4: the deposit-return queue - completed rentals whose deposit is still
  // outstanding, ordered by how overdue they are.
  @@index([ownerId, status, completedAt])
  @@map("bookings")
}

// ==================== HANDOVER MODELS ====================

/**
 * What condition an item was in when it changed hands. Trust & Safety.
 * WHY THIS EXISTS. Payment is offline and there is no escrow, so a deposit
 * dispute is two people asserting different things about an item neither of them
 * has any longer. `startBooking` and `completeBooking` were each one party's
 * unilateral click with nothing recorded, so there was never anything to argue
 * from. This is the record.
 * SEALED ON WRITE. There is no update path for condition, notes or photos, and
 * @@unique([bookingId, type]) means a second attempt at the same handover is
 * refused rather than replacing the first. A record its author can revise after
 * the fact is not evidence, it is a claim - and the moment it matters is exactly
 * the moment they would want to revise it.
 * THE CONFIRMATION IS SEPARATE AND OPTIONAL. Requiring the counterparty to agree
 * before the booking could move would let a silent party freeze someone's rental
 * and deposit indefinitely. So the record is required and the agreement is not;
 * what IS recorded is which of the two happened.
 */
model HandoverRecord {
  id        String       @id @default(cuid())
  bookingId String
  type      HandoverType

  condition HandoverCondition
  notes     String?           @db.Text

  // Always the owner under the current lifecycle: both transitions are
  // owner-driven. Stored rather than derived, because who wrote a record is part
  // of the record and the lifecycle may later let a renter file their own.
  recordedById String
  recordedAt   DateTime @default(now())

  confirmation     HandoverConfirmation @default(PENDING)
  confirmedById    String?
  confirmedAt      DateTime?
  // The counterparty's own words. The only place a renter's account of the
  // condition is captured, so a disagreement is not reduced to a boolean.
  confirmationNote String?              @db.Text

  createdAt DateTime @default(now())

  booking     Booking         @relation(fields: [bookingId], references: [id])
  recordedBy  User            @relation("HandoversRecorded", fields: [recordedById], references: [id])
  confirmedBy User?           @relation("HandoversConfirmed", fields: [confirmedById], references: [id])
  photos      HandoverPhoto[]

  // Trust & Safety: the claim resting on this record, if one was ever filed.
  claims DamageClaim[]

  // One record per direction. The database refuses a second pickup or return
  // rather than the application having to notice.
  @@unique([bookingId, type])
  @@index([bookingId])
  @@index([recordedById])
  // The queue of records still awaiting an answer from the other party.
  @@index([confirmation])
  @@map("handover_records")
}

/**
 * Condition photos taken at a handover.
 * A model rather than a String[] so `publicId` travels with the URL - Cloudinary
 * deletion needs it, exactly as ListingImage does. `order` keeps the sequence the
 * uploader chose, since "the third photo" is how people refer to them.
 */
model HandoverPhoto {
  id         String @id @default(cuid())
  handoverId String

  url      String
  publicId String @unique
  order    Int    @default(0)

  createdAt DateTime @default(now())

  handover HandoverRecord @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  @@index([handoverId, order])
  @@map("handover_photos")
}

// ==================== DAMAGE CLAIM MODELS ====================

/**
 * An owner's claim against a rental's security deposit. Trust & Safety.
 * WHAT A CLAIM IS, GIVEN THAT THE PLATFORM HOLDS NOTHING. The deposit passes
 * directly between the two people and SamaanShare never touches it - see the
 * note at the top of src/lib/bookings/deposit.ts. So a claim cannot move money.
 * What it does is change the amount the platform STATES is owed back: settle a
 * claim for 15,000 of a 60,000 deposit and the obligation becomes 45,000. That
 * is the same thing deposit.ts already exists to do, applied to a disagreement.
 * A REAL FOREIGN KEY TO THE BOOKING, deliberately, and this is the whole reason
 * the model exists rather than another ReportReason. A claim is about a specific
 * rental: its deposit, its two parties, its dates, and the condition record
 * written when the item came back. Report.targetId is polymorphic with no
 * foreign key and can reach none of them.
 * ONE PER BOOKING. The owner states everything at once rather than drip-feeding
 * a second claim after the first is answered.
 */
model DamageClaim {
  id        String @id @default(cuid())
  bookingId String @unique

  // Both derived from the booking, never accepted from input - the same rule as
  // a review's direction. A claimant supplied by the client could aim a demand
  // for money at somebody who was not party to the rental.
  claimantId   String // the owner
  respondentId String // the renter

  reason      ClaimReason
  // Required, unlike a handover note. A handover record can be a grade alone
  // because two people are standing in a doorway; a claim asks for money and has
  // to say what for.
  description String      @db.Text

  /**
   * PKR, whole rupees, capped at the booking's security deposit.
   * The cap is not arbitrary. The deposit is the only obligation the platform
   * has any standing to describe; damage beyond it is a matter between the two
   * people, and a figure larger than the deposit would imply this platform could
   * enforce something it cannot.
   */
  amountClaimed Int

  /**
   * The RETURN condition record this claim rests on.
   * Optional, and the interesting case is when it CONTRADICTS the claim: an
   * owner who graded the item AS_EXPECTED at the door and then claimed damage is
   * not blocked, because genuinely hidden faults exist - but the contradiction is
   * surfaced to whoever resolves it, which is more useful than a refusal.
   */
  handoverId String?

  status ClaimStatus @default(OPEN)

  // The renter's answer. `respondedAt` stays null through an escalation, so a
  // claim that reached DISPUTED by silence is distinguishable from one the
  // renter actually contested.
  respondedAt  DateTime?
  responseNote String?   @db.Text

  // The administrator's determination. Only ever set from DISPUTED.
  resolvedById String?
  resolvedAt   DateTime?
  resolution   String?   @db.Text

  /**
   * What the platform ends up saying the owner may keep. PKR.
   * Set to `amountClaimed` when the renter accepts, or to the administrator's
   * own figure between 0 and `amountClaimed` when they resolve it. Null while
   * open, because "nothing decided yet" and "decided as nothing" are different
   * facts and the deposit obligation differs between them.
   */
  amountUpheld Int?

  filedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking    Booking         @relation(fields: [bookingId], references: [id])
  claimant   User            @relation("ClaimsFiled", fields: [claimantId], references: [id])
  respondent User            @relation("ClaimsAgainst", fields: [respondentId], references: [id])
  resolvedBy User?           @relation("ClaimsResolved", fields: [resolvedById], references: [id])
  handover   HandoverRecord? @relation(fields: [handoverId], references: [id])
  photos     ClaimPhoto[]

  @@index([status]) // the administrator's queue
  @@index([claimantId])
  @@index([respondentId])
  // The lazy escalation sweep: open claims whose response window has closed.
  @@index([status, filedAt])
  @@map("damage_claims")
}

/**
 * Photographs supporting a claim.
 * Separate from HandoverPhoto rather than reused: those are sealed to the moment
 * of handover and must never gain images taken days later, which is exactly what
 * a claim attaches. Keeping them in different tables makes that impossible
 * rather than merely discouraged.
 */
model ClaimPhoto {
  id      String @id @default(cuid())
  claimId String

  url      String
  publicId String @unique
  order    Int    @default(0)

  // Who attached it. A claim carries the owner's photos and the renter's reply
  // may carry their own, and telling them apart is the point of the column.
  uploadedById String

  createdAt DateTime @default(now())

  claim      DamageClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  uploadedBy User        @relation("ClaimPhotos", fields: [uploadedById], references: [id])

  @@index([claimId, order])
  @@index([uploadedById])
  @@map("claim_photos")
}

// ==================== REVIEW MODELS ====================

model Review {
  id         String @id @default(cuid())
  bookingId  String
  reviewerId String // Who wrote the review
  revieweeId String // Who is being reviewed

  type    ReviewType
  rating  Int // 1-5
  comment String?    @db.Text

  /**
   * When this review became publicly visible. Phase 5.
   * RECIPROCAL RELEASE. A review is withheld until the counterpart submits theirs
   * or the review window closes. Without that, whoever writes second can read the
   * first and answer it, and ratings compress towards 5 because nobody risks
   * going first - the number stops carrying information.
   * WHY THIS IS A COLUMN AND NOT A DERIVED FLAG. `User.ratingAverage` is a stored
   * aggregate, and if it moved when a review was *written* it would leak the
   * withheld review's content: an owner watching their average drop knows the
   * renter left a bad one and can retaliate before it is visible. So the
   * aggregate counts only released reviews, which makes release a real event with
   * a time of its own rather than a predicate evaluated at read time.
   * Set either in the transaction that writes the second review, or by the lazy
   * sweep once the window has closed - the same pattern as booking expiry, and
   * for the same reason: a cron that stops running would leave reviews withheld
   * forever with nothing noticing.
   */
  publishedAt DateTime?

  /**
   * When a moderator removed this review. Trust & Safety.
   * SOFT, like User.deletedAt and Listing.deletedAt, and for a stronger reason
   * than either: a removed review is the evidence for the report that removed it
   * and for any appeal against that decision. Deleting the row would destroy the
   * only record of what was actually said, leaving a resolution note asserting it.
   * DISTINCT FROM publishedAt: null. Withheld means "not yet released", and the
   * release sweep will publish it the moment the window closes. Unpublishing a
   * review to hide it would therefore un-hide it a fortnight later. Removal has to
   * be its own state, and every public read filters on both.
   * A removed review is excluded from the rating aggregates too - leaving it
   * counted would keep a rating nobody is allowed to read.
   */
  removedAt DateTime?

  createdAt DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id])
  reviewer User    @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User    @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@unique([bookingId, reviewerId]) // One review per booking per person
  @@index([revieweeId])
  @@index([bookingId]) // P5
  @@index([reviewerId]) // P5
  @@index([revieweeId, type]) // P6: asOwner/asRenter split - API.md:696
  // Phase 5: public review lists and the rating aggregate both read released
  // reviews only, newest first.
  @@index([revieweeId, publishedAt])
  // Phase 5: the lazy release sweep - withheld reviews past their window.
  @@index([publishedAt])
  // Trust & Safety: public lists and both aggregates read live reviews only,
  // and every one of those queries is scoped to a single reviewee.
  @@index([revieweeId, removedAt])
  @@map("reviews")
}

// ==================== NOTIFICATIONS ====================
// P1: entire model. In-app booking notifications, ROADMAP.md:155 (Phase 1 Must).

model Notification {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType

  title String
  body  String? @db.Text

  // Deep-link target, e.g. entityType "booking" + entityId -> /bookings/:id.
  // Deliberately not a foreign key: notifications outlive the rows they
  // reference and must survive their deletion.
  entityType String?
  entityId   String?

  readAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt]) // unread badge count
  @@index([userId, createdAt]) // notification feed, newest first
  @@map("notifications")
}

// ==================== SAVED/WISHLIST ====================

model SavedListing {
  id        String @id @default(cuid())
  userId    String
  listingId String

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId]) // P5
  @@map("saved_listings")
}

// ==================== ADMIN AUDIT ====================

/**
 * One thing an administrator did to one account. Phase 6.
 * EVERY ADMIN ACTION AGAINST A USER WRITES ONE, whether it came from the
 * moderation queue or from the members screen. Before this, suspending someone
 * through `resolveReport` left the Report row as the only evidence and the User
 * row said nothing but SUSPENDED - so an account suspended by hand would have
 * left no trace at all of who decided it or why.
 * `reportId` is what keeps the two paths from diverging: a suspension prompted by
 * a report carries it, a standalone one does not, and both produce the same
 * record either way.
 * NOTHING HERE IS EVER UPDATED OR DELETED. It is an append-only account of what
 * staff have done, and a log its author can revise is not one.
 */
model AdminAction {
  id String @id @default(cuid())

  /**
   * The administrator responsible. NULL only for the bootstrap grant.
   * There is no administrator to attribute the first one to - that is the whole
   * problem it solves - and recording a fiction would be worse than recording the
   * gap. `scripts/grant-admin.ts` is the only thing that writes a null actor.
   */
  actorId   String?
  subjectId String

  type AdminActionType

  /**
   * Why. Required, unlike a report's resolution note.
   * A report can close unexplained and simply read as unexplained. This changes
   * somebody's access to the platform, and a decision nobody can read the
   * reasoning for is one nobody can review or appeal.
   */
  reason String @db.Text

  // What changed, as plain strings rather than typed columns: this one model
  // covers a UserStatus change and a UserRole change, and two typed pairs would
  // leave half of them null on every row.
  previousValue String?
  newValue      String?

  /**
   * The report this action answered, when it came from the moderation queue.
   */
  reportId String?

  /**
   * The listing this action was about, for REMOVE_LISTING/RESTORE_LISTING/EDIT_LISTING.
   * NULL for every action on an account itself.
   * A real foreign key, unlike `Report.targetId`. A report is polymorphic across
   * three kinds of target and cannot have one (D4); this column is only ever a
   * listing, so there is no reason to give up the join - and the listing detail
   * screen reads its own history through it.
   */
  listingId String?

  createdAt DateTime @default(now())

  actor   User?    @relation("AdminActionsTaken", fields: [actorId], references: [id])
  subject User     @relation("AdminActionsReceived", fields: [subjectId], references: [id])
  report  Report?  @relation(fields: [reportId], references: [id])
  /**
   * RESTRICT, matching `subjectId` rather than `reportId`'s SET NULL, and stated
   * explicitly because the default for an optional relation is SET NULL - which is
   * what this said for a while. The database was correct (the
   * `20260827090000_admin_listing_moderation` migration wrote RESTRICT by hand and
   * explained why); it was this line that had drifted, and the next generated
   * migration would have quietly reverted the database to match it.
   * Which listing was taken down is the substance of an audit entry, not a
   * cross-reference that can be dropped. Listings are soft-deleted (D3) and never
   * removed, so this never fires in normal operation.
   */
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: Restrict)

  // The history shown on one account's detail screen, newest first.
  @@index([subjectId, createdAt])
  @@index([actorId])
  @@index([reportId])
  // The same, for one listing's detail screen.
  @@index([listingId, createdAt])
  @@map("admin_actions")
}

// ==================== REPORTING/MODERATION ====================

model Report {
  id         String     @id @default(cuid())
  reporterId String
  type       ReportType // USER, LISTING, REVIEW

  // D4: kept as documented - polymorphic id with no foreign key. Referential
  // integrity of the target is enforced in application code, not the database.
  targetId String

  reason      ReportReason // D5: was free text
  description String?      @db.Text

  status     ReportStatus  @default(PENDING)
  resolvedBy String? // Admin who resolved
  resolvedAt DateTime?
  resolution String? // Notes on resolution
  action     ReportAction? // P4: action taken - API.md:425

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reporter User  @relation("ReportsSubmitted", fields: [reporterId], references: [id])
  resolver User? @relation("ReportsResolved", fields: [resolvedBy], references: [id])

  // Phase 6: the admin actions this report prompted.
  adminActions AdminAction[]

  @@index([status])
  @@index([type])
  @@index([reason]) // P5: report triage by category
  @@index([reporterId]) // P5
  @@index([resolvedBy]) // P5
  @@index([type, targetId]) // P5: "show all reports against this listing"
  @@map("reports")
}

