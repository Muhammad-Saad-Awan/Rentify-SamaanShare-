# ========================================
# SamaanShare - Environment Variables
# ========================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control
#
# Validated at startup by src/config/env.schema.ts. A missing or malformed
# REQUIRED value fails the boot with every problem listed at once, rather than
# surfacing as a mystery 500 on the first request that happens to need it.
# Anything marked optional below is a feature that is simply not offered when
# absent - no Google button, no password-reset link, uploads throw at the point
# of use naming the variables.

# ----------------
# Application
# ----------------
# Used for absolute URLs in metadata, the sitemap and email links. Defaults to
# http://localhost:3000 when blank. Trailing slashes are stripped.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Not read by any code. The values live in src/config/site.ts and
# src/config/locale.ts, where they belong - a brand name is not deployment
# configuration. Kept here only so an existing .env.local does not look wrong.
# NEXT_PUBLIC_APP_NAME=SamaanShare
# NEXT_PUBLIC_APP_TIMEZONE=Asia/Karachi
# NEXT_PUBLIC_DEFAULT_CURRENCY=PKR

# ----------------
# Database (Prisma + Neon PostgreSQL)
# ----------------
# Get both URLs from https://console.neon.tech -> your project -> Connect.
# They differ only by "-pooler" in the hostname.
#
# DATABASE_URL = POOLED endpoint (hostname contains "-pooler").
#   Used by the app at runtime through the Prisma driver adapter. PgBouncer
#   fans many serverless invocations onto few Postgres connections.
#
# DIRECT_URL = DIRECT endpoint (no "-pooler").
#   Used by the Prisma CLI for `migrate`, because migrations run session-level
#   statements PgBouncer cannot serve. Optional: on a plain Postgres server
#   with no pooler, leave it blank and the CLI falls back to DATABASE_URL.
#
# Use sslmode=verify-full rather than Neon's default sslmode=require: the `pg`
# driver currently treats them the same, but plans to weaken `require` to libpq
# semantics in pg v9. Being explicit keeps full certificate verification.
#
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full&channel_binding=require
DATABASE_URL=
DIRECT_URL=

# ----------------
# Authentication (Auth.js v5)
# ----------------
# REQUIRED. The key that encrypts the session cookie (a JWE) and signs the CSRF
# token. Auth.js reads AUTH_SECRET automatically - never import it in code.
# Changing it invalidates every existing session, logging everyone out.
# Generate with:  npx auth secret        (writes it for you)
#            or:  openssl rand -base64 32
AUTH_SECRET=

# Canonical origin Auth.js builds OAuth callback URLs from.
# Leave blank on Vercel - it is derived from VERCEL_URL automatically.
#
# REQUIRED for any production build outside Vercel, including a local
# `npm run build && npm run start`. Auth.js only relaxes its host check in
# development: in production it refuses an unrecognised Host header and every
# request to /api/auth/* fails with `UntrustedHost`, which presents as sign-in
# being completely broken rather than as a config error. `next dev` does default
# to http://localhost:3000, which is why this can look optional until the first
# production run.
AUTH_URL=http://localhost:3000

# Only for self-hosted deployments outside Vercel, where Auth.js cannot verify
# the origin and refuses to trust the incoming Host header. Setting this to true
# tells it to trust that header, so the proxy in front MUST set it safely.
# AUTH_TRUST_HOST=true

# Google OAuth - Phase 1.2 (https://console.cloud.google.com)
# Auth.js infers these from the AUTH_{PROVIDER}_{ID|SECRET} naming convention,
# so the Google provider needs no explicit clientId/clientSecret in code.
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ----------------
# File Storage (Cloudinary)
# ----------------
# Get from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----------------
# Transactional email (Resend)
# ----------------
# OPTIONAL, but password reset and email verification are not offered without
# it: the "Forgot password?" link is not rendered at all, rather than leading to
# a form that accepts an address and silently sends nothing.
#
# Get the key from https://resend.com/api-keys
RESEND_API_KEY=

# The From address. MUST be on a domain verified with Resend, or delivery fails
# at send time with a provider error.
#
# Defaults to "SamaanShare <onboarding@resend.dev>" when blank - Resend's shared
# testing sender, which only ever delivers to the address that owns the API key.
# That makes it fine for local work and useless for anything real, so set a
# verified domain before staging.
#
# Accepts a bare address or "Name <address>".
EMAIL_FROM=

# ----------------
# Admin Configuration
# ----------------
# Not read by any code yet. Admins are promoted by setting User.role directly;
# there is no bootstrap-from-env path. Left here as a reminder that the launch
# checklist needs one.
# ADMIN_EMAIL=admin@samaanshare.pk

# ----------------
# Future: Payment Gateways (Phase 2+)
# ----------------
# JazzCash (https://sandbox.jazzcash.com.pk/)
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# JAZZCASH_INTEGRITY_SALT=

# Easypaisa (https://developer.easypaisa.com.pk/)
# EASYPAISA_STORE_ID=
# EASYPAISA_HASH_KEY=

# Safepay (https://safepay.pk/)
# SAFEPAY_API_KEY=
# SAFEPAY_SECRET_KEY=

# PayFast (https://payfast.co.za/)
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=

# Stripe (Phase 4 - International)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
