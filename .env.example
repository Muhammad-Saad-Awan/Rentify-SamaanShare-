# ========================================
# SamaanShare - Environment Variables
# ========================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control

# ----------------
# Application
# ----------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SamaanShare
NEXT_PUBLIC_APP_TIMEZONE=Asia/Karachi
NEXT_PUBLIC_DEFAULT_CURRENCY=PKR

# ----------------
# Database (Prisma + Neon PostgreSQL)
# ----------------
# Get both URLs from https://console.neon.tech -> your project -> Connect.
# They differ only by "-pooler" in the hostname.
#
# DATABASE_URL = POOLED endpoint (hostname contains "-pooler").
#   Used by the app at runtime through the Prisma driver adapter. PgBouncer
#   fans many serverless invocations onto few Postgres connections.
#
# DIRECT_URL = DIRECT endpoint (no "-pooler").
#   Used by the Prisma CLI for `migrate`, because migrations run session-level
#   statements PgBouncer cannot serve. Optional: on a plain Postgres server
#   with no pooler, leave it blank and the CLI falls back to DATABASE_URL.
#
# Use sslmode=verify-full rather than Neon's default sslmode=require: the `pg`
# driver currently treats them the same, but plans to weaken `require` to libpq
# semantics in pg v9. Being explicit keeps full certificate verification.
#
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full&channel_binding=require
DATABASE_URL=
DIRECT_URL=

# ----------------
# Authentication (Auth.js v5)
# ----------------
# REQUIRED. The key that encrypts the session cookie (a JWE) and signs the CSRF
# token. Auth.js reads AUTH_SECRET automatically - never import it in code.
# Changing it invalidates every existing session, logging everyone out.
# Generate with:  npx auth secret        (writes it for you)
#            or:  openssl rand -base64 32
AUTH_SECRET=

# Canonical origin Auth.js builds OAuth callback URLs from.
# Leave blank on Vercel - it is derived from VERCEL_URL automatically.
# Locally, Auth.js defaults to http://localhost:3000; set this only if the dev
# server runs on another port or behind a tunnel (e.g. ngrok for OAuth testing).
# AUTH_URL=http://localhost:3000

# Only for self-hosted deployments outside Vercel, where Auth.js cannot verify
# the origin and refuses to trust the incoming Host header. Setting this to true
# tells it to trust that header, so the proxy in front MUST set it safely.
# AUTH_TRUST_HOST=true

# Google OAuth - Phase 1.2 (https://console.cloud.google.com)
# Auth.js infers these from the AUTH_{PROVIDER}_{ID|SECRET} naming convention,
# so the Google provider needs no explicit clientId/clientSecret in code.
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ----------------
# File Storage (Cloudinary)
# ----------------
# Get from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----------------
# Admin Configuration
# ----------------
# Email address for initial admin account
ADMIN_EMAIL=admin@samaanshare.pk

# ----------------
# Future: Payment Gateways (Phase 2+)
# ----------------
# JazzCash (https://sandbox.jazzcash.com.pk/)
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# JAZZCASH_INTEGRITY_SALT=

# Easypaisa (https://developer.easypaisa.com.pk/)
# EASYPAISA_STORE_ID=
# EASYPAISA_HASH_KEY=

# Safepay (https://safepay.pk/)
# SAFEPAY_API_KEY=
# SAFEPAY_SECRET_KEY=

# PayFast (https://payfast.co.za/)
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=

# Stripe (Phase 4 - International)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
