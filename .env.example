# ========================================
# SamaanShare - Environment Variables
# ========================================
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control

# ----------------
# Application
# ----------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SamaanShare
NEXT_PUBLIC_APP_TIMEZONE=Asia/Karachi
NEXT_PUBLIC_DEFAULT_CURRENCY=PKR

# ----------------
# Database (Prisma + Neon PostgreSQL)
# ----------------
# Get both URLs from https://console.neon.tech -> your project -> Connect.
# They differ only by "-pooler" in the hostname.
#
# DATABASE_URL = POOLED endpoint (hostname contains "-pooler").
#   Used by the app at runtime through the Prisma driver adapter. PgBouncer
#   fans many serverless invocations onto few Postgres connections.
#
# DIRECT_URL = DIRECT endpoint (no "-pooler").
#   Used by the Prisma CLI for `migrate`, because migrations run session-level
#   statements PgBouncer cannot serve. Optional: on a plain Postgres server
#   with no pooler, leave it blank and the CLI falls back to DATABASE_URL.
#
# Use sslmode=verify-full rather than Neon's default sslmode=require: the `pg`
# driver currently treats them the same, but plans to weaken `require` to libpq
# semantics in pg v9. Being explicit keeps full certificate verification.
#
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full&channel_binding=require
DATABASE_URL=
DIRECT_URL=

# ----------------
# Authentication (Auth.js v5)
# ----------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ----------------
# File Storage (Cloudinary)
# ----------------
# Get from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----------------
# Admin Configuration
# ----------------
# Email address for initial admin account
ADMIN_EMAIL=admin@samaanshare.pk

# ----------------
# Future: Payment Gateways (Phase 2+)
# ----------------
# JazzCash (https://sandbox.jazzcash.com.pk/)
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# JAZZCASH_INTEGRITY_SALT=

# Easypaisa (https://developer.easypaisa.com.pk/)
# EASYPAISA_STORE_ID=
# EASYPAISA_HASH_KEY=

# Safepay (https://safepay.pk/)
# SAFEPAY_API_KEY=
# SAFEPAY_SECRET_KEY=

# PayFast (https://payfast.co.za/)
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=

# Stripe (Phase 4 - International)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
